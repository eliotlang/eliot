import eliot.file.Path
import eliot.collection.List

// Merge copy of the base declaration so the implementation below can resolve it (name resolution is per-file). The
// merge verifies this copy agrees with the abstract effect in the stdlib layer, which carries the documentation.
effect Environment {
   def arguments: List[String]
   def environmentVariable(name: String): Option[String]
   def workingDirectory: Path
}

/**
 * The JVM `standardEnvironment`, the body of the base's declaration: each operation calls its `private` leaf native.
 * None of them can fail, so none declares a row — an absent variable is an `Option`, not an error.
 */
implement standardEnvironment: Environment {
   def arguments: List[String] = argumentsInternal

   def environmentVariable(name: String): Option[String] = valueOrNone(environmentVariableInternal(name))

   def workingDirectory: Path = workingDirectoryInternal
}

/**
 * Turn what the leaf native returns into the `Option` the ability promises: `System.getenv` signals "not set" with a
 * `null`, which is not a value any Eliot type admits, so it becomes a `None` here — in ordinary Eliot, at the narrowest
 * boundary, following the rule that a native never constructs an Eliot `data` value in bytecode.
 */
private def valueOrNone(value: String): Option[String] = if(isNull(value), None) else Some(value)

/**
 * The program's arguments, as the `java.util.List` an Eliot `List` already is.
 *
 * The backend stores the `String[]` handed to the synthesized entry point into a static field of the entry-point class
 * and this native reads it back, so the list is exactly what the JVM was invoked with, minus the JVM's own arguments and
 * the main class — which is what makes the "no program name" promise on `arguments` true rather than approximate.
 * Implemented by the backend.
 */
private def argumentsInternal: List[String]

/**
 * `System.getenv(name)`, `null` when unset. Implemented by the backend.
 *
 * The stated size is the JVM's `String` ceiling (see `readLineInternal` in `eliot.effect.Console`); the environment
 * itself imposes no smaller limit the JVM exposes.
 */
private def environmentVariableInternal(name: String): String {closed(0, 2147483647)}

/**
 * The `user.dir` system property as a normalized absolute `java.nio.file.Path`. Implemented by the backend.
 */
private def workingDirectoryInternal: Path

/**
 * `true` when `x` is the null reference. The `eliot.file`/`eliot.effect.Console` leaf of the same name and purpose;
 * per-file name resolution means each module declares its own. Implemented by the backend.
 */
private def isNull[A](x: A): Bool
