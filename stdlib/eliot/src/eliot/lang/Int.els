import eliot.compiler.Meta

/**
 * The type of integers, each carrying a compiler-tracked range of the values it may hold.
 */
type Int {range: Interval[BigInteger]}

implement Numeric[Int] {
   def add(a: Int, b: Int): Int {range(a) + range(b)}
   def subtract(a: Int, b: Int): Int {range(a) - range(b)}
   def multiply(a: Int, b: Int): Int {range(a) * range(b)}
}

/**
 * An integer renders as its decimal digits, with a leading `-` when it is negative.
 *
 * The stated size is `atLeast(1)`: every integer renders as at least one code point — zero is `"0"`, not `""` — and
 * that floor holds on every target, so it belongs in the base beside the declaration rather than in a platform layer.
 * The ceiling is real but not writable: it is the digit count of the argument's range, a base-10 logarithm no
 * arithmetic leaf offers (`docs/meta.md` §18). A half-open interval is what lets this state
 * the half it knows instead of choosing between an invented maximum and saying nothing.
 */
implement Show[Int] {
   def show(value: Int): String {atLeast(1)}
}

/**
 * Two integers are equal when they denote the same number. Ranges play no part: an `Int` known to be `0..7` and
 * one known to be `0..255` compare by their values, since a range is meta-information about a type, not part of
 * the value it describes.
 */
implement Eq[Int] {
   def equals(a: Int, b: Int): Bool
}

implement Compare[Int] {
   def lessThanOrEqual(a: Int, b: Int): Bool
}
