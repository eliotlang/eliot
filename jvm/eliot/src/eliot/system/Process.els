import eliot.effect.Throw
import eliot.file.Path
import eliot.file.File
import eliot.collection.List

// Merge copy of the base declarations so the implementation below can resolve them (name resolution is per-file). The
// merge verifies these copies agree with the abstract effect in the stdlib layer, which carries the documentation.
effect Process {
   def run(command: List[String], workingDirectory: Path) uses Throw[IoError]: ProcessResult
   def runInheritingIo(command: List[String], workingDirectory: Path) uses Throw[IoError]: Int
   def registerExitCode(code: Int): Unit
}

// The concrete ProcessResult: the abstract accessors in the base layer merge with these generated data-field accessors,
// the established `IoError` pattern.
data ProcessResult(exitCode: Int, standardOutput: String, standardError: String)

/**
 * The opaque result of a leaf process native: an error message, or an exit code plus the two captured streams. A
 * four-slot native holder, so a native never has to construct an Eliot `data` value in bytecode — the `eliot.file`
 * `IoResult` pattern, one slot wider.
 */
type ProcessOutcome

/**
 * The JVM `Process` implementation, and the default one. Sharing `eliot.file`'s error type is deliberate: a program
 * that reads files *and* runs programs — every build tool — then has one failure channel to discharge instead of two.
 */
implement Process {
   def run(command: List[String], workingDirectory: Path) uses Throw[IoError]: ProcessResult = {
      val outcome = runInternal(command, workingDirectory)

      raiseError(outcome)

      ProcessResult(outcomeExitCode(outcome), outcomeStandardOutput(outcome), outcomeStandardError(outcome))
   }

   def runInheritingIo(command: List[String], workingDirectory: Path) uses Throw[IoError]: Int = {
      val outcome = runInheritingIoInternal(command, workingDirectory)

      raiseError(outcome)

      outcomeExitCode(outcome)
   }

   def registerExitCode(code: Int): Unit = registerExitCodeInternal(code)
}

/**
 * Raise the holder's error as an `IoError`, or do nothing when it holds a result. Kept separate from reading the
 * result so an operation reads as "call the native, check it, read it" — the shape `eliot.file.File`'s implementation
 * uses.
 */
private def raiseError(outcome: ProcessOutcome) uses Throw[IoError]: Unit =
   if(isNull(outcomeErrorMessage(outcome)), unit) else raise(IoError(outcomeErrorMessage(outcome)))

/**
 * Start `command` in `workingDirectory` (`java.lang.ProcessBuilder`), capturing both output streams, and wait for it.
 * Failure to *start* — no such executable, no such directory, interrupted — is caught into the holder's error slot; a
 * non-zero exit is not an error and lands in the exit-code slot. Implemented by the backend.
 */
private def runInternal(command: List[String], workingDirectory: Path): ProcessOutcome

/**
 * As `runInternal`, but with the child's standard streams inherited, so nothing is captured and the two stream slots
 * hold `""`. Implemented by the backend.
 */
private def runInheritingIoInternal(command: List[String], workingDirectory: Path): ProcessOutcome

/**
 * Store `code` in the exit-code field of the entry-point class, which the synthesized entry point reads after the
 * program's `main` returns and hands to `System.exit`. Implemented by the backend.
 *
 * A field for the same reason `Environment.argumentsInternal` reads one: the value has to cross from a leaf native in
 * this class to a method of the entry-point class, which is the one class an executable jar always has. Write-only on
 * purpose — nothing reads it back into Eliot, because a static cell a program can both write and read is one half of
 * Landin's knot, and the recursion gate exists to keep the other half out.
 */
private def registerExitCodeInternal(code: Int): Unit

/**
 * The error-message slot of an outcome holder (`null` when the process ran). Implemented by the backend.
 *
 * The stated size is the JVM's `String` ceiling (see `readLineInternal` in `eliot.effect.Console`).
 */
private def outcomeErrorMessage(outcome: ProcessOutcome): String {closed(0, 2147483647)}

/**
 * The exit-code slot of an outcome holder. Implemented by the backend.
 *
 * The stated range is the full 32-bit signed range, because that is what `java.lang.Process.exitValue()` returns and
 * nothing narrower is true of it on every JVM: the POSIX `0 .. 255` holds where the operating system truncates the
 * status to a byte, and Windows hands back an arbitrary `int` (`0xC0000005` for an access violation). A leaf's stated
 * transfer is axiomatic — nothing rechecks it — so a bound that is merely usually right would silently poison every
 * `where` downstream of an exit code. The wide statement is the honest one.
 */
private def outcomeExitCode(outcome: ProcessOutcome): Int {closed(0 - 2147483648, 2147483647)}

/**
 * The captured standard output of an outcome holder. Implemented by the backend.
 *
 * The stated size is the JVM's `String` ceiling (see `readLineInternal` in `eliot.effect.Console`): a child process
 * writes as much as it likes, so the representation's limit is the only true bound.
 */
private def outcomeStandardOutput(outcome: ProcessOutcome): String {closed(0, 2147483647)}

/**
 * The captured standard error of an outcome holder. Implemented by the backend.
 *
 * The stated size is the JVM's `String` ceiling, as `outcomeStandardOutput` above.
 */
private def outcomeStandardError(outcome: ProcessOutcome): String {closed(0, 2147483647)}

/**
 * `true` when `x` is the null reference — lets `raiseError` branch on the holder's slots in ordinary Eliot. Implemented
 * by the backend.
 */
private def isNull[A](x: A): Bool
