import eliot.compiler.Meta

// Merge copy of the base declaration so the implementation below can resolve it (name resolution is per-file). The
// merge verifies this copy agrees with the abstract declaration in the stdlib layer, which carries the documentation.
effect Inf {
   def forever(step uses *: Unit) uses *: Unit
}

/**
 * The JVM `standardInf`, the body of the base's declaration: the unbounded loop itself. `Inf` is *run, not discharged*,
 * so this is what the entry point binds when `Inf` reaches `main` — a deliberately non-terminating program. `step`
 * arrives suspended, so each iteration re-runs it and its effects repeat.
 */
implement standardInf: Inf {
   def forever(step uses *: Unit) uses *: Unit = foreverInternal(step)
}

/**
 * The single non-terminating operation: invokes a suspended computation endlessly. `private` so divergence is
 * reachable only through `forever`, which uses `Inf`. Implemented by the backend as an unbounded loop, which control
 * leaves only through a frame.
 */
private def foreverInternal(step uses *: Unit) uses *: Unit {endless(step)}
