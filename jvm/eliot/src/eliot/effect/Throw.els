import eliot.compiler.Meta

// Merge copy of the base declaration so the implementation below can resolve it (name resolution is per-file). The
// merge verifies this copy agrees with the abstract declaration in the stdlib layer, which carries the documentation.
effect Throw[E] {
   def raise[A](err: E): A
}

/**
 * The JVM `Throw[E]` implementation — the **single** one for this platform, since `Throw` is a control effect and a
 * discharger only installs the frame it exits to. It is **named**, so it is never a default: `Throw` has none, and a
 * `raise` nothing discharges does not compile. `runThrow` binds it around the computation it discharges with an
 * ordinary `with`, supplying the frame its escape made (`docs/effects.md` §11, D25).
 *
 * Its parameter is the frame `raise` leaves through, which reaches exactly the computation that `with` binds: never
 * the nearest frame of its type, so a helper's own `catch` cannot swallow its caller's `raise`.
 */
implement[E] escaping(frame: ThrowFrame[E]): Throw[E] {
   def raise[A](err: E): A = exitInternal(frame, err)
}

/**
 * Discharge `Throw[E]` by installing the frame `raise` exits to and running the computation inside it, bound to
 * `escaping` over that frame: `Right(a)` if it finished, `Left(err)` if it left. The platform body of the base's
 * body-less signature — the base may not carry it, because the exit primitive below is private to this layer.
 */
def runThrow[E, A](obj uses *, Throw[E]: A) uses *: Either[E, A] =
   escapeInternal((frame: ThrowFrame[E]) -> obj with escaping(frame), (err: E) -> Left(err), a -> Right(a))

/**
 * The frame a `raise` leaves through: made by `escapeInternal`. It has no constructor, so nothing else
 * can make one.
 */
type ThrowFrame[K]

/**
 * Make a fresh escape frame, hand it to `body`, and answer `onValue` of its result or `onExit` of whatever
 * `exitInternal` left through that frame with. The abortive half of the platform's control-flow primitives: on the JVM
 * a frame is an object compared by identity, and an exit through any other frame passes through this one.
 *
 * `private`, and re-declared per module rather than shared from one place, exactly as `isNull` is: a public escape is
 * one half of Landin's knot, and the recursion gate (`termination/PurityGuardTest`) exists to keep the other half out.
 * Implemented by the backend. It gives no effect: what runs on the frame is the `with` its caller writes.
 */
private def escapeInternal[K, A, R](body uses *: ThrowFrame[K] => A, onExit uses *: K => R, onValue uses *: A => R) uses *: R

/**
 * Leave through `frame`, carrying `err`. Control does not return, so the result stands in for a value of any type, and
 * that is what it states (`{never}`). Implemented by the backend.
 */
private def exitInternal[K, A](frame: ThrowFrame[K], err: K): A {never}
