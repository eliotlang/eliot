type List[A]

/**
 * The JVM `foldLeft`: the list-first primitive, applied strictly. With no carrier to thread there is nothing to bind —
 * `combine` performs whatever the caller's own declarations cover, where it is written, so this reduces to the plain
 * strict fold it always was underneath.
 */
def foldLeft[A, B](initial: B, combine uses *: A => B => B, list: List[A]): B =
  foldLeftInternal(list, initial, combine)

/**
 * The list-first fold primitive behind `foldLeft`. `private` so user code folds only through the dot-chainable
 * `foldLeft`; kept list-first (and thus always called fully applied) because the backend emits it as a single erased
 * generic native, which cannot be partially applied. Implemented by the backend.
 */
private def foldLeftInternal[A, B](list: List[A], initial: B, combine uses *: A => B => B): B
