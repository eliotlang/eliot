/**
 * The logging effect: emitting diagnostic messages.
 *
 * Can be used in any context, even in otherwise pure functions to
 * emit the usual log messages. This is a purposefully minimal
 * api and is expected to be wrapped by a more powerful one on
 * a specific platform.
 */
effect Log {
   /**
    * Emit a diagnostic message; the platform chooses the destination.
    */
   def log(s: String): Unit
}

/**
 * The platform's own `Log`, over the platform's log: what the entry point binds for a `main` that declares `uses Log`.
 * Declared here and bodied by each platform, so code can be run on the real implementation portably, with `with
 * standardLog`.
 */
implement standardLog: Log
