
// Discharge is a frame inside the body: the `else` discharges the `Abort` its `if` introduced, so `demo` honestly
// declares only `uses Console` — the `Abort` never reaches its clause. A bare `if` with no `else` would need
// `uses Console, Abort`, and the scope check would name the missing entry at the reference.
def demo(flag: Bool) uses Console: Unit = printLine(if(flag, "discharged: ON") else "discharged: OFF")

def main uses Console: Unit = {
   printLine("========== discharge demo ==========")
   demo(true)
}
