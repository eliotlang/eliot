/**
 * Substituting a fake implementation of an **application-owned effect** for a test, without the production code
 * knowing. (Was `EffectsFakeCarrier` before effects v6 — there is no carrier to fake any more.)
 *
 * The point: `greet` below is ordinary production code. It declares `uses Terminal` and nothing else — no injected
 * handler, no extra parameter, no test hook. What decides whether `Terminal` means a real terminal or a recorded
 * transcript is the **implementation name** bound to it, and that is written entirely at the test site.
 *
 * `Terminal` ships no default implementation at all, which is exactly the honest state of an effect a program has not
 * decided how to run: a `Terminal` reaching `main` would be an error at the run boundary naming the effect.
 *
 * ```sh
 * ./mill examples.run jvm exe-jar examples/src/ -m EffectsNamedEffect
 * java -jar target/EffectsNamedEffect.jar
 * ```
 */
effect Terminal {
   def write(line: String): Unit

   def read: String
}

// Production code: direct style, with no knowledge that a test exists.
def greet uses Terminal: Unit = {
   val name = read
   write("Hello, " ++ name ++ "!")
}

// The test double. `read` hands back a canned line; `write` appends to the transcript through `Writer[String]`, which
// its clause declares and the binding site is charged for. Neither performs any I/O, and neither could: a user module
// declares no natives.
implement session: Terminal {
   def write(line: String) uses Writer[String]: Unit = tell(line ++ ";")

   def read: String = "Bob"
}

// Running the fake: `with` binds `greet`'s operations to `session`, and `runWriterToLog` discharges the `Writer` its
// clauses perform. The result is a plain `String` a test framework can assert on.
def greetTranscript: String = runWriterToLog(greet with session)

def main uses Console: Unit = printLine(greetTranscript)
