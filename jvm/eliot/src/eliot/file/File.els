import eliot.effect.Throw
import eliot.file.Path
import eliot.collection.List

// Merge copy of the FileSystem effect so the implementation below can resolve it (name resolution is per-file). The
// merge verifies this copy agrees with the abstract declaration in the base layer, which carries the documentation.
effect FileSystem {
   def readFile(path: Path) uses Throw[IoError]: String
   def writeFile(content: String, path: Path) uses Throw[IoError]: Unit
   def appendFile(content: String, path: Path) uses Throw[IoError]: Unit
   def foldLines[B](initial: B, step: B => String => B, path: Path) uses Throw[IoError]: B
   def foldCodePoints[B](initial: B, step: B => Int => B, path: Path) uses Throw[IoError]: B
   def readLines(path: Path) uses Throw[IoError]: List[String]
   def exists(path: Path) uses Throw[IoError]: Bool
   def isDirectory(path: Path) uses Throw[IoError]: Bool
   def listDirectory(path: Path) uses Throw[IoError]: List[Path]
   def walk(path: Path) uses Throw[IoError]: List[Path]
   def createDirectories(path: Path) uses Throw[IoError]: Unit
   def delete(path: Path) uses Throw[IoError]: Unit
}

// The concrete IoError: a message. The abstract `message` in the base layer merges with this generated data-field
// accessor.
data IoError(message: String)

def ioError(message: String): IoError = IoError(message)

/**
 * The opaque result of a leaf file native: either an error message or a value, kept as a two-slot native holder so a
 * native never has to construct an Eliot `data` value in bytecode. Read back with `resultErrorMessage`/`resultValue`
 * and reflected into `Throw[IoError]` by `raiseError` below.
 */
type IoResult

/**
 * The JVM `FileSystem` implementation, and the default one: anonymous, in the effect's own module. Each operation calls
 * its `private` impure leaf native directly — there is no carrier to reify into and nothing to lift — and then
 * `raiseError`s the native's error-or-value holder into `Throw[IoError]`, which every member declares.
 *
 * A test does not replace this: it declares its own named `implement` of `FileSystem` wherever it likes and binds it
 * with `with`, so a faked filesystem needs no type of its own and no colocation.
 */
implement FileSystem {
   def readFile(path: Path) uses Throw[IoError]: String = {
      val r = readFileInternal(path)
      raiseError(r)
      resultValue(r)
   }

   def writeFile(content: String, path: Path) uses Throw[IoError]: Unit = raiseError(writeFileInternal(content, path))

   def appendFile(content: String, path: Path) uses Throw[IoError]: Unit = raiseError(appendFileInternal(content, path))

   def foldLines[B](initial: B, step: B => String => B, path: Path) uses Throw[IoError]: B = {
      val r = foldLinesInternal(initial, step, path)
      raiseError(r)
      resultValue(r)
   }

   def foldCodePoints[B](initial: B, step: B => Int => B, path: Path) uses Throw[IoError]: B = {
      val r = foldCodePointsInternal(initial, step, path)
      raiseError(r)
      resultValue(r)
   }

   def readLines(path: Path) uses Throw[IoError]: List[String] = {
      val r = readLinesInternal(path)
      raiseError(r)
      resultAsList(r)
   }

   def exists(path: Path) uses Throw[IoError]: Bool = {
      val r = existsInternal(path)
      raiseError(r)
      resultValue(r)
   }

   def isDirectory(path: Path) uses Throw[IoError]: Bool = {
      val r = isDirectoryInternal(path)
      raiseError(r)
      resultValue(r)
   }

   def listDirectory(path: Path) uses Throw[IoError]: List[Path] = {
      val r = listDirectoryInternal(path)
      raiseError(r)
      resultAsList(r)
   }

   def walk(path: Path) uses Throw[IoError]: List[Path] = {
      val r = walkInternal(path)
      raiseError(r)
      resultAsList(r)
   }

   def createDirectories(path: Path) uses Throw[IoError]: Unit = raiseError(createDirectoriesInternal(path))

   def delete(path: Path) uses Throw[IoError]: Unit = raiseError(deleteInternal(path))
}

/**
 * Raise the holder's error as an `IoError`, or do nothing when it holds a value. Kept separate from reading the value
 * so an operation reads as "call the native, check it, read it" — three ordinary strict statements, which is all
 * sequencing is now.
 */
private def raiseError(r: IoResult) uses Throw[IoError]: Unit =
   if(isNull(resultErrorMessage(r)), unit) else raise(IoError(resultErrorMessage(r)))

/**
 * Read the whole regular file at `path` (`java.nio.file.Files.readString`), wrapped in a result holder. Implemented by
 * the backend.
 */
private def readFileInternal(path: Path): IoResult

/**
 * Read every line of the regular file at `path` into a `java.util.List` (`Files.readAllLines`). Implemented by the
 * backend.
 */
private def readLinesInternal(path: Path): IoResult

/**
 * Write `content` to `path`, creating or truncating (`Files.writeString`). Implemented by the backend.
 */
private def writeFileInternal(content: String, path: Path): IoResult

/**
 * Append `content` to `path`, creating it if absent (`Files.writeString` with CREATE/APPEND). Implemented by the
 * backend.
 */
private def appendFileInternal(content: String, path: Path): IoResult

/**
 * `Files.exists(path)`, wrapped. Implemented by the backend.
 */
private def existsInternal(path: Path): IoResult

/**
 * `Files.isDirectory(path)`, wrapped. Implemented by the backend.
 */
private def isDirectoryInternal(path: Path): IoResult

/**
 * The immediate entries of the directory at `path` as a `java.util.List` of `Path` (`Files.list`). Implemented by the
 * backend.
 */
private def listDirectoryInternal(path: Path): IoResult

/**
 * Every regular file under `path`, depth-first, as a `java.util.List` of `Path` (`Files.walk`). Implemented by the
 * backend.
 */
private def walkInternal(path: Path): IoResult

/**
 * `Files.createDirectories(path)`. Implemented by the backend.
 */
private def createDirectoriesInternal(path: Path): IoResult

/**
 * `Files.delete(path)`. Implemented by the backend.
 */
private def deleteInternal(path: Path): IoResult

/**
 * Fold over the lines of `path` (`Files.newBufferedReader` + `readLine` loop), calling `step(acc)(line)` per line, in
 * constant space; the whole loop is wrapped so an I/O error becomes a result holder. Implemented by the backend.
 */
private def foldLinesInternal[B](initial: B, step: B => String => B, path: Path): IoResult

/**
 * Fold over the Unicode code points of `path`, calling `step(acc)(codePoint)` per code point. Implemented by the
 * backend.
 */
private def foldCodePointsInternal[B](initial: B, step: B => Int => B, path: Path): IoResult

/**
 * The value slot of a result holder (`null` when it holds an error). Implemented by the backend.
 */
private def resultValue[A](r: IoResult): A

/**
 * The value slot of a result holder as a `List[E]` — a `List`-headed sibling of `resultValue` for the directory/line
 * operations, so a `List`-shaped result is read back at its own head. Implemented by the backend.
 */
private def resultAsList[E](r: IoResult): List[E]

/**
 * The error-message slot of a result holder (`null` when it holds a value). Implemented by the backend.
 *
 * The stated size is the JVM's `String` ceiling (see `readLineInternal` in `eliot.effect.Console`): the message comes
 * from an arbitrary `java.io` exception, so nothing narrower is true of it.
 */
private def resultErrorMessage(r: IoResult): String {closed(0, 2147483647)}

/**
 * `true` when `x` is the null reference — lets `raiseError` branch on the holder's slots in ordinary Eliot. Implemented by
 * the backend.
 */
private def isNull[A](x: A): Bool
