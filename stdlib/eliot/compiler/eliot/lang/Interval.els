import eliot.compiler.Meta

data Interval[T](start: Bound[T], end: Bound[T])

def interval[T](start: Bound[T], end: Bound[T]): Interval[T] = Interval(start, end)

def closed[T](start: T, end: T): Interval[T] = Interval(Bounded(start), Bounded(end))

def atLeast[T](start: T): Interval[T] = Interval(Bounded(start), Unbounded)

def atMost[T](end: T): Interval[T] = Interval(Unbounded, Bounded(end))

def whole[T]: Interval[T] = Interval(Unbounded, Unbounded)

def rangeWithin[Lo: BigInteger, Hi: BigInteger](i: Interval[BigInteger]): Bool = i.start match {
   case Unbounded -> false
   case Bounded(s) -> i.end match {
      case Unbounded -> false
      case Bounded(e) -> lessThanOrEqual(Lo, s) && lessThanOrEqual(e, Hi)
   }
}

/**
 * An `Interval[T]` (e.g. `Interval[BigInteger]`, an `Int`'s value range) is a refinement **domain** — the value a range
 * is tracked as by the bounds-as-refinements channel (`docs/bounds-as-refinements.md`). Its lattice `join` covers two
 * ranges: the least interval containing both is `[min of the starts, max of the ends]`, delegating to `minBound`/
 * `maxBound`. Those absorb on an unbounded endpoint, which is exact here rather than merely safe — the least of "no
 * lower limit" and any start is again no lower limit, and the mirror holds at the end — so joining a half-open range
 * with a closed one keeps the half that is still bounded: `join([0, ∞), [2, 5])` is `[0, ∞)`.
 *
 * Its `widen` opens each endpoint that moved: an endpoint can only move once, to unbounded, so a loop's range is stable
 * after at most two widenings. `widen([0, 0], [0, 1])` is `[0, ∞)`, and `widen([0, 5], [0, 5])` stays `[0, 5]`.
 *
 * A compiler-pool-only instance, exercised at `match`/`if` branch merges (the auto-derived `Meta[Int$Meta]` join
 * dispatches to it on the range slot).
 */
implement[T ~ Compare[T]] Meta[Interval[T]] {
   def join(a: Interval[T], b: Interval[T]): Interval[T] =
      Interval(minBound(start(a), start(b)), maxBound(end(a), end(b)))
   def widen(previous: Interval[T], next: Interval[T]): Interval[T] =
      Interval(lowered(start(previous), start(next)), raised(end(previous), end(next)))
}

/**
 * The compiler platform's self-sufficient copy of the runtime `Numeric[Interval[T]]` instance (base signatures + jvm
 * bodies) — structurally identical, so the refinement channel's `Int` arithmetic transfers (the `Numeric[Int]` methods
 * `add`/`subtract`/`multiply`, whose `^Meta` companion braces are `add`/`subtract`/`multiply` over the operand ranges)
 * dispatch through *this instance* rather than
 * a hand-copied plain function. The channel's post-monomorphize executor links the instance at its own monomorphization
 * (`docs/refinement-channel-follow-ups.md`), so the endpoint-wise delegation bottoms out at the endpoints'
 * `Numeric[Bound[BigInteger]]` — and under that the `Numeric[BigInteger]` compile-time leaves (and, for
 * multiplication's corner selection, `Compare`):
 *
 *   - `[a, b] + [c, d] = [a + c, b + d]`
 *   - `[a, b] - [c, d] = [a - d, b - c]`   (subtraction pairs a start with the other end)
 *   - `[a, b] * [c, d] = [min of the four corner products, max of them]`
 *
 * Add and subtract stay exact on a half-open range; multiply widens to `whole` on one. See the base declaration.
 */
implement[T ~ Numeric[T] & Compare[T]] Numeric[Interval[T]] {
   def add(a: Interval[T], b: Interval[T]): Interval[T] =
      Interval(add(start(a), start(b)), add(end(a), end(b)))
   def subtract(a: Interval[T], b: Interval[T]): Interval[T] =
      Interval(subtract(start(a), end(b)), subtract(end(a), start(b)))
   def multiply(a: Interval[T], b: Interval[T]): Interval[T] = {
      val c11 = multiply(start(a), start(b))
      val c12 = multiply(start(a), end(b))
      val c21 = multiply(end(a), start(b))
      val c22 = multiply(end(a), end(b))
      Interval(minBound(minBound(minBound(c11, c12), c21), c22), maxBound(maxBound(maxBound(c11, c12), c21), c22))
   }
}

/**
 * The start `previous` widens to when `next` follows it: `previous` while `next` is not below it, else unbounded.
 */
private def lowered[T ~ Compare](previous: Bound[T], next: Bound[T]): Bound[T] = previous match {
   case Unbounded -> Unbounded
   case Bounded(x) -> next match {
      case Unbounded -> Unbounded
      case Bounded(y) -> fold(lessThanOrEqual(x, y), Bounded(x), Unbounded)
   }
}

/**
 * The end `previous` widens to when `next` follows it: `previous` while `next` is not above it, else unbounded.
 */
private def raised[T ~ Compare](previous: Bound[T], next: Bound[T]): Bound[T] = previous match {
   case Unbounded -> Unbounded
   case Bounded(x) -> next match {
      case Unbounded -> Unbounded
      case Bounded(y) -> fold(lessThanOrEqual(y, x), Bounded(x), Unbounded)
   }
}
