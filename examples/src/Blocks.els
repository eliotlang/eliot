// Block syntax: `val` bindings and statement sequencing.
//
// A block `{ … }` is a sequence of statements/bindings ending in a result expression. It lowers to a tower of
// immediately-applied lambdas, and since every call is strict the statements run in order: a `val` binds the result
// of an effectful step (or a plain value), and a bare statement runs for its effects and is discarded — no
// hand-written `flatMap` nest.


// `swap` reads the current state, installs `next`, and returns the previous value. In block form:
//   `val old = state`      binds the current state,
//   `putState(next)`       is a bare effectful statement,
//   `old`                  is the result expression.
// This is exactly the immediately-applied lambdas it lowers to:
//   (old -> (_ -> old)(putState(next)))(state)
def swap(next: String) uses State[String]: String = {
  val old = state
  putState(next)
  old
}

// A two-effect interaction using `Console` and `State[String]`, also direct-style: announce the change, perform the
// swap, and report the previous value. Each call runs where it is written, on the bindings `rename`'s caller hands it.
def rename(next: String) uses Console, State[String]: Unit = {
  printLine("renaming the account...")
  val previous = swap(next)
  printLine(previous)
}

// `main` is itself a block ending in an expression. The first binding is a plain `val` holding the `Pair` produced by
// discharging `State`, inside a body that declares `uses Console`; only `State` is discharged, `Console` rides on.
// The discharger takes `rename("after")` as code at its own `uses` slot, so it is called directly rather than
// dot-chained — `.` transports a value, never code.
def main uses Console: Unit = {
  val outcome = runStateToPair("before", rename("after"))
  printLine(outcome.second)
}
