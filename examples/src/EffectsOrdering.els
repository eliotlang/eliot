// A validation that always rejects: it aborts regardless of its input. `abort` stands in for a value of any type.
def reject(value: String) uses Abort: String = abort

// ONE program using `State` and `Abort`: install a new state, THEN abort. Direct style — a block is strict evaluation order. The
// interaction question — "does the abort roll back the state?" — is deliberately left open by the `uses` clause,
// decided only by the ORDER the two dischargers install their frames below.
def modifyThenAbort uses State[String], Abort: String = {
   putState("modified")
   reject("modified")
}

// Discharge Abort first (inner), State second (outer): State SURVIVES the abort. The cell is installed OUTSIDE the
// escape frame, so leaving that frame does not take it down — result Pair[Option[String], S], with the value None but
// the final state "modified" still threaded out.
def stateSurvives: Pair[Option[String], String] = runStateToPair("initial", runAbort(modifyThenAbort))

// Discharge State first (inner), Abort second (outer): the abort DISCARDS the state. Now the cell is installed INSIDE
// the escape frame, so leaving that frame takes the cell with it — result Option[Pair[String, S]], and there is no
// surviving state at all.
def stateDiscarded: Option[Pair[String, String]] = runAbort(runStateToPair("initial", modifyThenAbort))

def main uses Console: Unit = {
   printLine(stateSurvives.first.foldOption("<no value>", s -> s))
   printLine(stateSurvives.second)
   printLine(stateDiscarded.foldOption("<no state>", p -> p.second))
}
