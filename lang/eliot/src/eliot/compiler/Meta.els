/**
 * The interface **meta-information** must implement so the compiler can track it as extra
 * compile-time knowledge about a value.
 *
 * A *meta-information* `D` is a compile-time summary of what is known about a runtime value —
 * more precise than its type alone. The built-in example is an `Int`'s value range, which the
 * compiler carries as an `Interval[BigInteger]`: the type says "an integer", the refinement says
 * "between `0` and `255`". Implementing `Meta[D]` registers `D` as such a meta-information, so the compiler
 * can follow a `D` through the program and combine two `D`s wherever control flow merges.
 *
 * ```eliot
 * // A compile-time summary of a number's sign. Carried alongside a value, it lets the
 * // compiler know a value is (say) always positive without running the program.
 * data Sign = Negative | Zero | Positive | AnySign   // AnySign: sign not known
 *
 * implement Eq[Sign] { ... }
 *
 * // Enable Sign to be used as Meta-information
 * implement Meta[Sign] {
 *    // Equal signs stay; any disagreement widens to AnySign — the least precise
 *    // sign that still covers both possibilities.
 *    def join(a: Sign, b: Sign): Sign = if(a == b) a else AnySign
 * }
 * ```
 */
ability Meta[D] {
   /**
    * Combine two meta-information values into the least one that covers both.
    *
    * Called wherever a value can come from more than one branch: an `if`/`match` chooses one arm
    * at runtime, so the compiler only knows the result is one branch *or* the other and must
    * describe it with a refinement that fits either. For an `Int`'s range that join is `[min of
    * the two starts, max of the two ends]`; for the `Sign` above, two equal signs stay and
    * a disagreement widens to `AnySign`.
    */
   def join(a: D, b: D): D
}

/**
 * The join of `a` and `b`, at a meta-information the compiler holds only as a type argument.
 *
 * The compiler asks for it when it checks an argument against a parameter's meta brace: the
 * argument's meta fits when joining it into the stated one leaves the stated one unchanged.
 */
def joined[D ~ Meta](a: D, b: D): D = join(a, b)

/**
 * The meta-information of a value that is never produced: the call stating it does not return.
 *
 * A primitive that leaves through a frame, or loops forever, states it on its result. It is no
 * meta-information of any type: every join absorbs it, so a branch that does not return adds
 * nothing to what the other branches produce, and a call one of whose arguments does not return
 * is never made.
 *
 * ```eliot
 * private def exitInternal[K, A](frame: AbortFrame[K], nothing: K): A {never}
 * ```
 */
def never[D]: D

/**
 * A fresh frame, made by the call stating it and handed to its code: the frame that code's
 * exits leave through.
 *
 * Stated after the domain of the code it is handed to. It, and the six primitives below, are
 * statements about frames and cells, the private state a platform's control primitives keep
 * for one call. The compiler follows that state for the one call that made it, so a frame
 * collects what exits through it, and a cell holds what was last written into it.
 *
 * ```eliot
 * private def escapeInternal[K, A, R](body uses *: AbortFrame[K] {frame} => A, ...) uses *: R
 * ```
 */
def frame[D]: D

/**
 * A fresh cell holding `initial`, made by the call stating it and handed to its code.
 *
 * ```eliot
 * private def withCellInternal[S, A, R](initial: S, body uses *: StateCell[S] {cell(initial)} => A, ...) uses *: R
 * ```
 */
def cell[S, D](initial: S): D

/**
 * Leave through `frame`, carrying `carried`: the frame receives it, and the call stating it does
 * not return.
 *
 * ```eliot
 * private def exitInternal[K, A](frame: AbortFrame[K], nothing: K): A {exit(frame, nothing)}
 * ```
 */
def exit[F, K, D](frame: F, carried: K): D

/**
 * What the exits of `code` carried through the frame it was handed. A code handed this is not
 * run when nothing exited.
 *
 * ```eliot
 * onExit uses *: K {exited(body)} => R
 * ```
 */
def exited[C, D](code: C): D

/**
 * The content of the cell `code` was handed, when `code` returned.
 *
 * ```eliot
 * combine uses *: A {body} => S {stored(body)} => R
 * ```
 */
def stored[C, D](code: C): D

/**
 * The content of `cell` where it is read.
 *
 * ```eliot
 * private def readCellInternal[S](cell: StateCell[S]): S {content(cell)}
 * ```
 */
def content[C, D](cell: C): D

/**
 * Replace the content of `cell` with `value`.
 *
 * ```eliot
 * private def writeCellInternal[S](cell: StateCell[S], s: S): Unit {store(cell, s)}
 * ```
 */
def store[C, S, D](cell: C, value: S): D

/**
 * What a call of a `data` constructor is: the value it built from its arguments. The compiler
 * writes it on every constructor, so following a value through a `match` needs no rule about
 * `match`.
 *
 * ```eliot
 * Some[A](value: A): Option[A] {built}
 * ```
 */
def built[D]: D

/**
 * What a `match` hands one argument of the handler for `constructor`: that field of `value`
 * when `constructor` built it, and nothing — the handler does not run — when another one did.
 * The compiler writes it on every `match` eliminator.
 *
 * ```eliot
 * handleCases$Handed$case1$0 = fieldOf(value, Some[A])
 * ```
 */
def fieldOf[V, C, D](value: V, constructor: C): D

/**
 * `fieldOf`, for a field whose declaration states its meta: `otherwise`, that stated meta, is
 * what is handed where it is not known what built `value`.
 */
def fieldOr[V, C, D](value: V, constructor: C, otherwise: D): D = otherwise
