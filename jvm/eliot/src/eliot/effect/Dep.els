// Merge copy of the base declaration so the implementation below can resolve it (name resolution is per-file). The
// merge verifies this copy agrees with the abstract declaration in the stdlib layer, which carries the documentation.
effect Dep[X] {
   def dependency: X
}

/**
 * The JVM `Dep[X]` implementation — the single one for this platform, the reader's `ask`: `dependency` reads the cell
 * its `provide` made and handed to exactly the computation it provides for.
 */
implement[X] Dep[X](cell: DepCell[X]) {
   def dependency: X = readCellInternal(cell)
}

/**
 * Discharge `Dep[X]` by installing a cell for `X` holding `x` and running the computation inside it, keeping only its
 * result — nothing writes this cell, so its final content is `x` again. The platform body of the base's body-less
 * signature.
 */
def provide[X, A](x: X, computation uses *, Dep[X]: A) uses *: A = withCellInternal(x, computation, a -> _ -> a)

/**
 * The cell `dependency` reads: made by `withCellInternal`. It has no constructor, so nothing else
 * can make one.
 */
type DepCell[S]

/**
 * Make a fresh cell holding `initial`, run `body` with it, and answer the result paired with the cell's final content.
 * `eliot.effect.State`'s leaf of the same shape and purpose; per-module `private` means each module declares its own.
 * Implemented by the backend. `body` is given `Dep[S]` and the cell, as `State`'s copy gives `State[S]` (D20 rule 5).
 */
private def withCellInternal[S, A, R](initial: S, body uses *, Dep[S]: A, combine uses *: A => S => R) uses *: R

/**
 * The content of `cell`. Implemented by the backend.
 */
private def readCellInternal[S](cell: DepCell[S]): S
