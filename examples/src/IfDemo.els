
// `if` is an ordinary function: `if(cond, value)` yields `value`, or short-circuits via the `Abort` effect, which the
// infix `else` (from `eliot.effect.Abort`) discharges with the alternative. Because the branch is a suspended slot, it
// may be pure OR effectful, and only the selected branch is ever run — so this reads like an imperative `if`.

// Every form of if..else, all driven by the single `flag` parameter. `demo` declares only `uses Console`: every
// `if`'s `Abort` is fully discharged by its matching `else`, so a discharged effect never joins the clause.
def demo(flag: Bool) uses Console: Unit = {
   // 1. A pure value chosen by an if..else, then printed.
   printLine(if(flag, "1. pure value: ON") else "1. pure value: OFF")

   // 2. Guard-style default: a value, or a fallback when the condition fails.
   printLine(if(flag, "2. guard: custom") else "2. guard: default")

   // 3. Pure  if .. else if .. else  chain (else is right-associative, so the chain nests).
   printLine(if(flag, "3. chain: first") else if(!flag, "3. chain: second") else "3. chain: third")

   // 4. Effectful branches: only the taken branch's printLine is executed.
   if(flag, printLine("4. effectful: then")) else printLine("4. effectful: else")

   // 5. Effectful  if .. else if .. else  chain.
   if(flag, printLine("5. chain: A")) else if(!flag, printLine("5. echain: B")) else printLine("5. echain: C")

   // 6. A branch that runs a multi-statement effectful computation.
   if(flag) {
      printLine("6. Multi-statement body...")
      printLine("     ...(announced)")
   } else printLine("6. plain else")
}

// `if..else` needs no `uses` clause at all: in a PURE function the `else` discharges the `Abort` the `if` introduced,
// and nothing is left over — so branching code looks exactly like it would in any other language, a plain `String` in
// and a plain `String` out.
def sign(flag: Bool): String = if(flag, "+") else "-"

// The same in an if..else if..else chain, and through a block `val` holding the discharged branch.
def describe(a: Bool, b: Bool): String = {
   val category = if(a, "first") else if(b, "second") else "third"
   category
}

// `fold` is the raw two-armed eliminator that `if` is built on: `if(cond, v)` is exactly `fold(cond, v, abort)`, and
// `else` discharges that abort. The difference is that `fold` takes BOTH arms explicitly and adds no `Abort` to the
// caller's clause. Both arms are suspended (`uses *`), so only the selected one ever runs and a pure arm sits happily beside
// an effectful one — they need only agree on the value type they yield.
def foldForms(flag: Bool) uses Console: Unit = {
   // 1. Two pure arms of one type: `fold` selects a value and uses no effect (result is `String`).
   printLine(fold(flag, "1. fold pure: then", "1. fold pure: else"))

   // 2. Two effectful arms: `A` is `Unit`, each arm uses the caller's `Console`, and only the chosen one runs.
   fold(flag, printLine("2. fold effectful: then"), printLine("2. fold effectful: else"))

   // 3. The arms agree on their value type; what one of them performs on the way is not part of that agreement.
   printLine(fold(flag, "3. fold same-type arms: A", "3. fold same-type arms: B"))
}

def main uses Console: Unit = {
   // With a compile-time constant: `demo(true)` / `foldForms(true)` may be reduced by the compiler. No `else` is
   // needed — both use only `Console`, which `main` declares and the entry point binds.
   printLine("========== constant: true ==========")
   demo(true)
   foldForms(true)
   printLine(sign(true))
   printLine(describe(false, true))

   // With a runtime value. An effectful condition — `readLine orElse ""` — simply runs where it is written, exactly
   // like `printLine(readLine orElse "")`. We bind it once into `answer` (each `readLine` reads the *next* line, so we
   // read a single time and reuse the pure `Bool`), then drive both demos. Feed "yes" on stdin for the true branches,
   // anything else for the false branches.
   val answer = readLine orElse ""
   val flag   = answer == "yes"
   printLine("========== runtime: readLine == yes ==========")
   demo(flag)
   foldForms(flag)
}
