/**
 * Substituting a fake implementation of a **standard-library effect** — here `Console` — for a test, without the
 * production code knowing.
 *
 * The whole mechanism is a **named implementation** plus a `with`. `recordingConsole` is an ordinary declaration in
 * this module: it needs no type of its own, no colocation with `Console`, and it is never searched for or checked
 * against the platform's default, because a named implementation is never a default. `with` binds it for the calls
 * lexically inside its subject, and nothing else in the program changes.
 *
 * `EffectsNamedEffect` shows the same thing for an *application-owned* effect; the only difference there is that
 * nothing ships a default at all.
 *
 * ```sh
 * ./mill examples.run jvm exe-jar examples/src/ -m EffectsFakeConsole
 * java -jar target/EffectsFakeConsole.jar
 * ```
 */

// Production code: direct style, and unaware that a test exists. It declares `uses Console` and names no implementation,
// so it commits to no interpretation of it.
def greeting(name: String) uses Console: Unit = printLine("Hello, " ++ name ++ "!")

// The test double: one declaration, no fixture. Its clauses declare what the double itself performs — `uses
// Writer[String]` — and that is charged wherever the name is bound, which is what makes the transcript come out below.
//
// It cannot cheat: a user module declares no natives, and the platform's are private to its layer, so a double reaches
// the outside world only through effects its own clauses declare — and those are charged and bound like any other.
implement recordingConsole: Console {
   def printLine(s: String) uses Writer[String]: Unit = tell(s ++ ";")

   def readLine: Option[String] = None
}

// Running the fake: `with` binds `greeting`'s `printLine` to the double, whose `Writer[String]` the `runWriterToLog`
// slot supplies and discharges. The result is a plain `String` a test can assert on — and, because there is no carrier
// to instantiate, it may be written anywhere, including inside an effectful body as `main` does below.
def transcript: String = runWriterToLog(greeting("Bob") with recordingConsole)

def main uses Console: Unit = {
   printLine(transcript)
   printLine(runWriterToLog({
      greeting("Ann")
      greeting("Bob")
   } with recordingConsole))
}
