/**
 * The state effect: a computation that threads a state of type `S`, reading and replacing it.
 *
 * A function that uses state declares `uses State[S]` and reads the current state as `state` or replaces it with
 * `putState`. Neither wraps the result — the effect floats up to the caller's clause. The result paired with the final state is
 * materialised only when the effect is discharged by `runStateToPair`, as a `Pair[A, S]` (or `runStateToValue` /
 * `runStateToFinalState` to keep only one side).
 *
 * ```eliot
 * def tick uses State[Int]: Unit = putState(state + 1)
 * ```
 *
 * A **control effect**: one implementation per platform over that platform's private cell primitive, so there is
 * no interpretation to choose and nothing to bind with `with`. What *is* the user's to choose is the order the
 * frames are installed — `runStateToPair(s, runThrow(c))` and `runThrow(runStateToPair(s, c))` differ, and the
 * difference is written where the dischargers nest.
 */
effect State[S] {
   /**
    * Read the current state.
    */
   def state: S

   /**
    * Replace the current state with `s`.
    */
   def putState(s: S): Unit
}

/**
 * Transform the current state by applying `f` to it: reads the state, replaces it with `f(state)`, and yields `unit`.
 * A derived convenience over `state` + `putState` — `updateState(f)` is exactly `putState(f(state))` — so platform
 * layers get it for free, without implementing a third `State` operation.
 *
 * ```eliot
 * def tick uses State[Int]: Unit = updateState(n -> n + 1)
 * ```
 */
def updateState[S](f: S => S) uses State[S]: Unit = putState(f(state))

/**
 * Discharge the `State[S]` effect, materialising it as a `Pair[A, S]`: the result paired with the final state, threaded
 * from `initial`. Every other effect the computation performs is unaffected. Reach for `runStateToValue` or
 * `runStateToFinalState` to keep only one side of the pair.
 *
 * Body-less here and bodied per platform: threading a value through calls that never mention it is the cell
 * primitive, and a public cell is Landin's knot (`docs/effects.md` §9.6).
 */
def runStateToPair[S, A](initial: S, p uses *, State[S]: A): Pair[A, S]

/**
 * Discharge the `State[S]` effect keeping only the result, discarding the final state. Threads `initial` through the
 * computation and yields its value.
 */
def runStateToValue[S, A](initial: S, p uses *, State[S]: A): A = first(runStateToPair(initial, p))

/**
 * Discharge the `State[S]` effect keeping only the final state, discarding the result. Threads `initial` through the
 * computation and yields the state left behind.
 */
def runStateToFinalState[S, A](initial: S, p uses *, State[S]: A): S = second(runStateToPair(initial, p))
