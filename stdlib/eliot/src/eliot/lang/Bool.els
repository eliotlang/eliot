import eliot.effect.Abort
import eliot.compiler.Meta

type Bool

/**
 * Logical conjunction: `true` when both `a` and `b` are `true`.
 *
 * Both operands are ordinary values — there is no short-circuiting. To run a computation only when a condition
 * holds, branch with `if`..`else` instead.
 */
infix left def &&(a: Bool, b: Bool): Bool

/**
 * Logical disjunction: `true` when at least one of `a` and `b` is `true`.
 *
 * `||` binds *looser* than `&&` (as in most languages), so a mixed chain groups by conjunction first:
 * `a || b && c` is `a || (b && c)`. Operands are ordinary values; there is no short-circuiting.
 */
infix left below && def ||(a: Bool, b: Bool): Bool

/**
 * Logical negation: `true` becomes `false` and `false` becomes `true`.
 */
prefix def !(a: Bool): Bool

/**
 * The two-armed eliminator for `Bool`: yields `whenTrue` when `condition` holds, otherwise `whenFalse`.
 *
 * Both arms are **suspended**: they are declared as computations, so only the selected one is ever run, and an
 * effectful arm's effects join the caller's row exactly once. A pure arm sits happily beside an effectful one — it is
 * lifted to match — so both arms need only agree on the value type they yield.
 *
 * The refinement of the result is the join of the two arms': which arm applies is decided only at runtime, so the
 * compiler knows the result only as "one arm *or* the other" — e.g. an `Int` result's range covers both arms'
 * ranges.
 *
 * ```eliot
 * // Pure arms of one type: fold selects a value, using no effect at all.
 * def label(active: Bool): String = fold(active, "ON", "OFF")
 *
 * // Effectful arms: both are the caller's code using Console, and only the selected one runs.
 * def report(ok: Bool) uses Console: Unit =
 *    fold(ok, printLine("all good"), printLine("check failed"))
 * ```
 */
def fold[A](condition: Bool, whenTrue uses *: A, whenFalse uses *: A): A { join(whenTrue, whenFalse) }

/**
 * Conditional execution — the `if` of `if..else`: yields `value` when `condition` holds, otherwise short-circuits
 * via the `Abort` effect.
 *
 * Pair it with the infix `else` (in `eliot.effect.Abort`), which discharges the `Abort` with an alternative;
 * `else` binds right-associatively, so chains spell naturally as `if(..) else if(..) else ..`. Without an `else`
 * the `Abort` floats up into the caller's `uses` clause, making a bare `if` a guard in a `uses Abort` function.
 *
 * `value` is the caller's code: a plain value (`if(cond, "yes")`) or an effectful computation
 * (`if(cond, printLine("hi"))`, on the caller's own effects). Both branches of an `if..else` are *built*, but
 * only the selected one is ever *run*, so this reads like an imperative `if`.
 *
 * Since `if` curries just like all functions do, the second argument can appear after the first
 * argument is applied separately, so `if(cond, "yes")` becomes `if(conf) "yes"`, just like in
 * an imperative language.
 *
 * ```eliot
 * // A pure value chosen by a chain; else binds right-associatively.
 * def sign(n: Int): String = if(n > 0) "+" else if(n < 0) "-" else "0"
 *
 * // Effectful branches: only the taken branch's printLine runs, and else discharges
 * // the Abort, so greet declares only `uses Console`.
 * def greet(known: Bool, name: String) uses Console: Unit =
 *    if(known) printLine(name) else printLine("hello, stranger")
 *
 * // No else: a guard — the Abort floats up into the caller's clause.
 * def requirePositive(n: Int) uses Abort: Int = if(n > 0) n
 * ```
 */
def if[T](condition: Bool, value uses *, Abort: T) uses Abort: T = fold(condition, value, abort)

/**
 * Run `action` when `condition` holds, and do nothing otherwise — a one-armed `if` for a statement, with no `Abort`
 * to discharge and no `else unit` to write.
 *
 * It curries like `if`, so the condition reads first: `when(missing) clone`. `action` runs only when `condition` holds,
 * and may perform whatever the enclosing definition declares.
 *
 * ```eliot
 * def refuseEmpty(lines: List[String]) uses Throw[String]: Unit = when(lines.isEmpty) raise("nothing to run")
 * ```
 */
def when(condition: Bool, action uses *: Unit): Unit = fold(condition, action, unit)

/**
 * Run `action` unless `condition` holds — `when` with the condition negated, which is how a check reads: state what
 * should be true, then what to do when it is not.
 *
 * ```eliot
 * def checked(result: ProcessResult) uses Throw[Int]: String = {
 *    unless(result.exitCode == 0) raise(result.exitCode)
 *    result.standardOutput
 * }
 * ```
 */
def unless(condition: Bool, action uses *: Unit): Unit = fold(condition, unit, action)
