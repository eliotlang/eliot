// Merge copy of the base declaration so the implementation below can resolve it (name resolution is per-file). The
// merge verifies this copy agrees with the abstract declaration in the stdlib layer, which carries the documentation.
effect Inf {
   def forever(step uses *: Unit): Unit
}

/**
 * The JVM `Inf` implementation: the unbounded loop itself. `Inf` is *run, not discharged*, so this is what the
 * synthesized entry point binds when `Inf` reaches `main` — a deliberately non-terminating program. `step` arrives
 * suspended, so each iteration re-runs it and its effects repeat.
 */
implement Inf {
   def forever(step uses *: Unit): Unit = foreverInternal(step)
}

/**
 * The single non-terminating operation: invokes a suspended computation endlessly. `private` so divergence is
 * reachable only through `forever`, which uses `Inf`. Implemented by the backend as an unbounded loop.
 */
private def foreverInternal(step uses *: Unit): Unit
