import eliot.compiler.Meta

// Merge copy of the base declaration so the implementation below can resolve it (name resolution is per-file). The
// merge verifies this copy agrees with the abstract declaration in the stdlib layer, which carries the documentation.
effect Dep[X] {
   def dependency: X
}

/**
 * The JVM `Dep[X]` implementation — the single one for this platform, the reader's `ask`: `dependency` reads the cell
 * its `provide` made and bound to exactly the computation it provides for with `with`. Named, as every effect
 * implementation is (`docs/effects.md` D26).
 */
implement[X] providing(cell: DepCell[X]): Dep[X] {
   def dependency: X = readCellInternal(cell)
}

/**
 * Discharge `Dep[X]` by installing a cell for `X` holding `x` and running the computation bound to `providing` over it,
 * keeping only its result — nothing writes this cell, so its final content is `x` again. The platform body of the base's
 * body-less signature.
 */
def provide[X, A](x: X, computation uses *, Dep[X]: A) uses *: A = withCellInternal(x, (cell: DepCell[X]) -> computation with providing(cell), a -> _ -> a)

/**
 * The cell `dependency` reads: made by `withCellInternal`. It has no constructor, so nothing else
 * can make one.
 */
type DepCell[S]

/**
 * Make a fresh cell holding `initial`, hand it to `body`, and combine the result with the cell's final content.
 * `eliot.effect.State`'s leaf of the same shape and purpose; per-module `private` means each module declares its own.
 * Implemented by the backend; it gives no effect.
 */
private def withCellInternal[S, A, R](initial: S, body uses *: DepCell[S] {cell(initial)} => A,
                                      combine uses *: A {body} => S {stored(body)} => R) uses *: R {combine}

/**
 * The content of `cell`. Implemented by the backend.
 */
private def readCellInternal[S](cell: DepCell[S]): S {content(cell)}
