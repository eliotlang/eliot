import eliot.compiler.Meta

// Merge copy of the base declaration so the implementation below can resolve it (name resolution is per-file).
effect State[S] {
   def state: S
   def putState(s: S): Unit
}

/**
 * The JVM `State[S]` implementation — the single one for this platform: the threaded value lives in the cell its
 * discharger made and bound to exactly the computation it discharges with `with`, so `state` reads it and `putState`
 * replaces it, and a helper's own `State` never sees its caller's. Named, as every effect implementation is
 * (`docs/effects.md` D26).
 */
implement[S] holding(cell: StateCell[S]): State[S] {
   def state: S = readCellInternal(cell)

   def putState(s: S): Unit = writeCellInternal(cell, s)
}

/**
 * Discharge `State[S]` by installing the cell `state`/`putState` reach, holding `initial`, and running the computation
 * bound to `holding` over it: the result paired with the cell's final content. The platform body of the base's body-less signature.
 *
 * Nesting is the user's: `runStateToPair(s, runThrow(c))` keeps the state across a `raise`, `runThrow(runStateToPair(s, c))`
 * does not, because the cell is gone when the frame it sat inside is exited.
 */
def runStateToPair[S, A](initial: S, p uses *, State[S]: A) uses *: Pair[A, S] =
   withCellInternal(initial, (cell: StateCell[S]) -> p with holding(cell), a -> s -> Pair(a, s))

/**
 * The cell `state` and `putState` reach: made by `withCellInternal`. It has no constructor, so nothing else
 * can make one.
 */
type StateCell[S]

/**
 * Make a fresh cell holding `initial`, hand it to `body`, and combine the result with the cell's final content.
 * The stateful half of the platform's control-flow primitives (`docs/effects.md` §9.6): on the JVM a cell is a one-slot
 * array local to this call, so it is gone when the call returns or is exited through.
 *
 * `private`, and re-declared per module rather than shared: a public cell *is* Landin's knot — a cell holding a closure
 * that reads the cell is a loop — and the recursion gate (`termination/PurityGuardTest`) exists to keep that out.
 * Implemented by the backend.
 *
 * It gives no effect: what runs on the cell is the `with` its caller writes (`docs/effects.md` D25).
 */
private def withCellInternal[S, A, R](initial: S, body uses *: StateCell[S] {cell(initial)} => A,
                                      combine uses *: A {body} => S {stored(body)} => R) uses *: R {combine}

/**
 * The content of `cell`. Implemented by the backend.
 */
private def readCellInternal[S](cell: StateCell[S]): S {content(cell)}

/**
 * Replace the content of `cell`. Implemented by the backend.
 */
private def writeCellInternal[S](cell: StateCell[S], s: S): Unit {store(cell, s)}
