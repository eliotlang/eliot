/**
 * An immutable, ordered sequence of `A` values.
 *
 * `List` is abstract in the base layer — it commits to no representation. A platform provides one: the JVM layer maps
 * it to a native `java.util.List` (so lists pass to and from Java library methods directly), immutable by contract —
 * `append` builds a fresh list and there is no mutator in this API.
 *
 * Build with `empty` and `append`, consume with `fold`:
 *
 * ```eliot
 * def digits: List[Int] = append(append(append(empty, 1), 2), 3)
 * def total(list: List[Int]): Int = list.foldLeft(0, e -> acc -> add(e, acc))
 * ```
 */
type List[A]

/**
 * The empty list.
 */
def empty[A]: List[A]

/**
 * A new list holding every element of `list` followed by `element`. `list` itself is unchanged.
 */
def append[A](list: List[A], element: A): List[A]

/**
 * A new list holding `element` followed by every element of `list`. `list` itself is unchanged.
 *
 * The front-insertion counterpart of `append`. A left fold can only extend a list at the back, so building one in
 * reverse — what `reverse` does — is exactly what this is for.
 */
def prepend[A](list: List[A], element: A): List[A]

/**
 * Reduce `list` to a single value: starting from `initial`, combine each element into the accumulator from front to
 * back — `append(append(empty, a), b).foldLeft(z, combine)` is `combine(b)(combine(a)(z))`.
 *
 * `list` is the last parameter, so this dot-chains as `list.foldLeft(initial, combine)`. `combine` is curried: it
 * takes an element, then the accumulator, and yields the next accumulator.
 *
 * The fold is **effect-transparent**: `combine` may perform effects, and they run once per element in order, on
 * the caller's own effects. A fold whose `combine` is pure performs none, and costs nothing for the possibility.
 */
def foldLeft[A, B](initial: B, combine uses *: A => B => B, list: List[A]): B
