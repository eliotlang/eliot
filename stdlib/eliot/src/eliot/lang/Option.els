type Option[A]

/**
 * The absent case of `Option`.
 */
def none[A]: Option[A]

// Merge copy of the lang layer's `some` (name resolution is per-file): `mapOption` and `someIf` below build with it,
// and without it neither compiled once reached.
def some[A](value: A): Option[A]

/**
 * Eliminate an `Option`: return `ifNone` when `o` is `None`, or `ifSome(value)` when it is `Some(value)`.
 *
 * ```eliot
 * def label(o: Option[String]): String = o.foldOption("absent", s -> s)
 * ```
 */
def foldOption[A, B](ifNone uses *: B, ifSome uses *: A => B, o: Option[A]): B

/**
 * The value `o` holds, or `fallback` when it holds none — the everyday way to consume an `Option`, without
 * naming either case:
 *
 * ```eliot
 * def main uses Console: Unit = printLine(readLine orElse "(no input)")
 * ```
 *
 * The fallback is only run when there is nothing to return, so it may be as expensive, or as effectful, as it
 * likes. It binds right, so a chain of fallbacks reads left to right: `first orElse second orElse "last resort"`.
 * Reach for `orAbort` instead when the absence should travel on as an effect rather than be answered here, and
 * for `foldOption` when the two cases deserve different treatment.
 */
infix right below (++, ||)
def orElse[A](o: Option[A], fallback uses *: A): A = foldOption(fallback, a -> a, o)

/**
 * `f` applied to the value `o` holds, leaving absence absent — the way to work on an optional value without naming
 * either case.
 *
 * `f` runs only when there is something to run it on, so it may be as expensive, or as effectful, as it likes. `o`
 * is the last parameter, so this dot-chains as `o.mapOption(f)`.
 *
 * ```eliot
 * // The length of a line, when there was one to read.
 * def readLength uses Console: Option[Int] = readLine.mapOption(length)
 * ```
 */
def mapOption[A, B](f uses *: A => B, o: Option[A]): Option[B] =
   o.foldOption(none, a -> some(f(a)))

/**
 * `value` when `condition` holds and absence otherwise — what an `if` with no `else` describes, as a value rather than
 * as an `Abort`.
 *
 * `value` is only run when `condition` holds. It curries like `if`, so the condition reads first and the value after it.
 *
 * ```eliot
 * def output(result: ProcessResult): Option[String] = someIf(result.exitCode == 0) result.standardOutput
 * ```
 */
def someIf[A](condition: Bool, value uses *: A): Option[A] = fold(condition, some(value), none)

/**
 * Run `action` on the value `o` holds, and do nothing when it holds none — the `Option` twin of a list's `foreach`.
 *
 * ```eliot
 * def refuseSecond(words: List[String]) uses Throw[String]: Unit = words.at(1).foreachOption(word -> raise("unexpected " ++ word))
 * ```
 */
def foreachOption[A](action uses *: A => Unit, o: Option[A]): Unit = o.foldOption(unit, action)

/**
 * `true` when `o` holds a value.
 */
def isSome[A](o: Option[A]): Bool = o.foldOption(false, _ -> true)

/**
 * `true` when `o` holds no value.
 */
def isNone[A](o: Option[A]): Bool = o.foldOption(true, _ -> false)

/**
 * `true` when `o` holds a value satisfying `predicate`, and `false` when it holds none — the `Option` twin of a list's
 * `any`.
 *
 * ```eliot
 * def startsWithComment(lines: List[String]): Bool = lines.head.anyOption(line -> line.startsWith("--"))
 * ```
 */
def anyOption[A](predicate uses *: A => Bool, o: Option[A]): Bool = o.foldOption(false, predicate)

/**
 * Two options are equal when both are absent, or both hold equal values — so `found == some(expected)` asks for a
 * particular value without taking the option apart first.
 */
implement[A ~ Eq] Eq[Option[A]] {
   def equals(a: Option[A], b: Option[A]): Bool = a.foldOption(b.isNone, value -> b.anyOption(other -> value == other))
}
