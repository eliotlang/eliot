/**
 * The result of a computation that may fail: `Left(error)` for failure, `Right(value)` for success.
 *
 * By convention the error sits in `Left` and the successful result in `Right`. It is what the
 * `Throw[E]` effect discharges into via `runThrow`: running a computation that uses `Throw[E]` yields a
 * `Right` holding its result or a `Left` holding the error that was raised. Consume one with `foldEither`.
 */
type Either[E, A]

/**
 * Eliminate an `Either`: apply `ifLeft` to a `Left`'s error, or `ifRight` to a `Right`'s value.
 *
 * ```eliot
 * def message(e: Either[String, Int]): String = e.foldEither(err -> err, n -> show(n))
 * ```
 */
def foldEither[E, A, B](ifLeft uses *: E => B, ifRight uses *: A => B, e: Either[E, A]): B
