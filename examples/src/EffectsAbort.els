
// A config lookup that aborts on a missing key — this stand-in knows exactly one. Mirrors the `uses Abort` setting
// lookups in the Abort docs: `if` passes the value through when its condition holds and aborts when it does not.
def lookupConfig(key: String) uses Abort: String = if(key == "app.name", "config-value")

// A lookup that succeeds. The value comes back unchanged; `uses Abort` is still declared, because the lookup it calls
// may short-circuit.
def safe uses Abort: String = lookupConfig("app.name")

// Direct style: announce the attempt, then look up a (missing) key, which aborts. A block is strict evaluation order
// and nothing more — no hand-written `flatMap` or sequencing helper.
def greetOrGiveUp uses Console, Abort: String = {
   printLine("looking up config...")
   lookupConfig("db.url")
}

// `else` discharges the `Abort` in one step, supplying a fallback if it short-circuits — no Option and no transformer in
// sight: it installs the frame `abort` leaves through, and reads what came back. `Abort` has one implementation per
// platform, so there is nothing here to choose or to bind.
def main uses Console: Unit = {
   printLine(safe else "<absent>")
   printLine(greetOrGiveUp else "gave up!")
}
