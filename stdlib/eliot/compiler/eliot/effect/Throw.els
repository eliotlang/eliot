// The compile-time `Throw`: what a guarded return's `raise("…")` performs, and what a compile-time `catch` discharges.
// The same shape as the jvm layer's (`jvm/eliot/src/eliot/effect/Throw.els`), over this track's own evaluator intrinsic
// instead of a bytecode leaf. `Throw` is re-declared here because name resolution is per-file; the layer merge verifies
// the copy agrees with the base.
effect Throw[E] {
   def raise[A](err: E): A
}

/**
 * The compile-time `Throw[E]` implementation: `raise` leaves through the frame its `runThrow` made, carrying the error.
 *
 * Its parameter is that frame, handed along the declared chain by the environment threading (`docs/effects.md` §3.4).
 * A signature's `raise` is discharged by the guarded-return read, which gives the signature that frame and reads what
 * left through it as the rejection, with its author's message. Spelled exactly as the jvm layer spells it, so the two
 * are one implementation and this one supersedes the borrowed one on the compile track.
 */
implement[E] Throw[E](frame: ThrowFrame[E]) {
   def raise[A](err: E): A = exitIntrinsic(frame, err)
}

/**
 * Discharge `Throw[E]` on the compile track: `Right(a)` if the computation finished, `Left(err)` if it left. The
 * platform body of the base's body-less signature.
 */
def runThrow[E, A](obj uses *, Throw[E]: A) uses *: Either[E, A] =
   escapeIntrinsic(obj, (err: E) -> Left(err), a -> Right(a))

/**
 * The frame a `raise` leaves through: made by `escapeIntrinsic`. It has no constructor, so nothing else can make one.
 */
type ThrowFrame[K]

/**
 * Make a fresh frame, run `body` with it, and answer `onValue` of its result, or `onExit` of what an `exitIntrinsic`
 * through that frame carried. Answered by the evaluator (`monomorphize/processor/EffectIntrinsics`); `body` is given
 * `Throw[K]` and its frame. Named apart from the jvm layer's `escapeInternal`, as `eliot.effect.Abort`'s is.
 */
private def escapeIntrinsic[K, A, R](body uses *, Throw[K]: A, onExit uses *: K => R, onValue uses *: A => R) uses *: R

/**
 * Leave through `frame`, carrying `err`. Answered by the evaluator; stuck when `frame` is not an installed frame.
 */
private def exitIntrinsic[K, A](frame: ThrowFrame[K], err: K): A
