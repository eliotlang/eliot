// Merge copy of the base declaration so the implementation below can resolve it (name resolution is per-file). The
// merge verifies this copy agrees with the abstract declaration in the stdlib layer, which carries the documentation.
effect Writer[W] {
   def tell(w: W): Unit
}

/**
 * The JVM `Writer[W]` implementation — the single one for this platform, `State` restricted to append-only: `tell`
 * joins `w` onto the content of its discharger's cell with the `Combine[W]` monoid, and nothing here can read it back
 * out, which is the whole contract.
 */
implement[W ~ Combine[W]] Writer[W](cell: WriterCell[W]) {
   def tell(w: W): Unit = writeCellInternal(cell, combine(readCellInternal(cell), w))
}

/**
 * Discharge `Writer[W]` by installing the cell `tell` appends to, starting from `empty`, and running the computation
 * inside it: the result paired with what was accumulated. The platform body of the base's body-less signature.
 */
def runWriterToPair[W ~ Combine[W], A](p: {Writer[W]} A): Pair[A, W] =
   withCellInternal(empty, p, a -> w -> Pair(a, w))

/**
 * The cell `tell` appends to: made by `withCellInternal`. It has no constructor, so nothing else
 * can make one.
 */
type WriterCell[S]

/**
 * Make a fresh cell holding `initial`, run `body` with it, and answer the result paired with the cell's final content.
 * `eliot.effect.State`'s leaf of the same shape and purpose; per-module `private` means each module declares its own.
 * Implemented by the backend. `body` is given `Writer[S]` and the cell, as `State`'s copy gives `State[S]` (D20 rule 5).
 */
private def withCellInternal[S, A, R](initial: S, body: {Writer[S]} A, combine: A => S => {} R): R

/**
 * The content of `cell`. Implemented by the backend.
 */
private def readCellInternal[S](cell: WriterCell[S]): S

/**
 * Replace the content of `cell`. Implemented by the backend.
 */
private def writeCellInternal[S](cell: WriterCell[S], s: S): Unit
